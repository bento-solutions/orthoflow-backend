# OrthoFlow production secrets. Copy to `.env` on the server (never commit the
# real file) and fill in strong, unique values.
#   openssl rand -base64 48
DB_PASSWORD=
JWT_SECRET=
FRONTEND_URL=https://ortho.crmbento.com
CORS_ALLOWED_ORIGINS=https://ortho.crmbento.com

# Leave true. /auth/register is a public endpoint (it has to create the first
# account on an empty DB); true restricts it to exactly that — the first
# account, forced to ADMIN — and requires an authenticated ADMIN for every
# account afterwards. Setting it false makes /auth/register open self-service
# and lets anyone register themselves as ADMIN.
RESTRICT_REGISTRATION_TO_BOOTSTRAP=true

# ── Voice: vendor keys (shared by transcription, interpretation, summary) ──
# Each stage falls back from one vendor to the next when one is overloaded or
# rate-limited, so each vendor's key is set once here. All server-side only.
#   gemini      https://aistudio.google.com/apikey — free-tier keys allow only
#               a few requests a minute (and ~20 a day on some models), which a
#               continuously-listening consultation exhausts in seconds; they
#               may also be used by Google to improve its products. Use a
#               paid key before real patients.
#   assemblyai  https://www.assemblyai.com/dashboard — fast transcription
#               fallback; the EU endpoint is used by default.
#   groq        https://console.groq.com — Whisper (last transcription
#               fallback), interpretation fallback, and the summary.
#   deepseek    https://platform.deepseek.com — interpretation and summary
#               fallback. Needs a funded balance (HTTP 402 otherwise).
VOICE_GEMINI_API_KEY=
VOICE_ASSEMBLYAI_API_KEY=
VOICE_GROQ_API_KEY=
VOICE_DEEPSEEK_API_KEY=
# Attestation, one per vendor: true only once you have confirmed that the key
# above is on a plan whose terms keep submitted audio/text out of the vendor's
# own model training, and that a data-processing agreement is in place. The
# backend cannot check a contract, so it logs a startup warning naming every
# vendor that receives patient data without this set. A free-tier key (Gemini
# AI Studio, Groq free) usually does NOT qualify.
VOICE_GEMINI_DATA_PROTECTED=false
VOICE_GROQ_DATA_PROTECTED=false
VOICE_DEEPSEEK_DATA_PROTECTED=false
VOICE_ASSEMBLYAI_DATA_PROTECTED=false

# ── Voice: server-side speech-to-text (optional, off by default) ────────────
# Leave VOICE_STT_ENABLED unset/false to keep using the browser's own
# recognition. Setting it true routes captured consultation audio through the
# provider below and needs a DPA, a lawful basis and a CNDP notification
# (Law 09-08) first — same bar as the NLU fallback. The key stays on the
# server and is never sent to the browser.
#
# PROVIDER (the primary): gemini | assemblyai | groq. FALLBACKS are tried in
# order when it fails, inside one time budget.
#   gemini  — Google's Interactions API. Markedly better on what this app
#             actually hears: French with Darija and English in the same
#             sentence, carrying dental vocabulary it can be told to expect.
#             Key from https://aistudio.google.com/apikey. Note that traffic on
#             a free AI Studio key may be used by Google to improve their
#             products; use a paid key (or Vertex AI) before real patients.
#   groq    — Whisper. Cheaper, phonetic-only, loses clinical terms more often.
#             Key from https://console.groq.com.
#   assemblyai — Universal-3.5 Pro via the synchronous API. Answers a clip in
#             ~0.6 s; its confidence score is used to drop noise.
# Throttling of the paid routes, per signed-in user (defaults shown; they are
# set to stop a runaway client or a stolen token, not to ration a busy doctor).
# VOICE_RATE_LIMIT_ENABLED=true
# VOICE_RATE_LIMIT_TRANSCRIBE_PER_MINUTE=40
# VOICE_RATE_LIMIT_TRANSCRIBE_PER_HOUR=1200
# VOICE_RATE_LIMIT_INTERPRET_PER_MINUTE=30
# VOICE_RATE_LIMIT_SUMMARIZE_PER_MINUTE=6
VOICE_STT_ENABLED=false
VOICE_STT_PROVIDER=assemblyai
VOICE_STT_FALLBACKS=gemini,groq
# Optional: the primary's key if not set as a vendor key above.
VOICE_STT_API_KEY=
# groq only: whisper-large-v3-turbo (fastest/cheapest) | whisper-large-v3
VOICE_STT_MODEL=whisper-large-v3-turbo
# groq only. Any OpenAI-compatible /audio/transcriptions endpoint; point at a
# self-hosted faster-whisper server to keep audio on-premise.
VOICE_STT_BASE_URL=https://api.groq.com/openai/v1
# gemini only.
VOICE_STT_GEMINI_MODEL=gemini-3.8-flash
# Retried when the primary answers 429/5xx ("experiencing high demand") and
# preferred for a minute afterwards. Blank disables the fallback.
VOICE_STT_GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# low | medium | high. gemini-3.8-flash rejects 'minimal'.
VOICE_STT_GEMINI_THINKING_LEVEL=low
# For the fallback model; gemini-3.5-flash accepts 'minimal' and is fastest with it.
VOICE_STT_GEMINI_FALLBACK_THINKING_LEVEL=minimal
VOICE_STT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── Voice: natural-language fallback (optional, off by default) ─────────────
# What happens to an utterance the on-device grammar cannot parse. With this
# disabled, a near-miss — "recurrence caries" instead of "recurrent caries" —
# is answered with "I didn't catch that" and the command is lost, however good
# the transcription was. This is what makes near-misses resolve to the command
# the dentist meant.
#
# PROVIDER: disabled | gemini | groq | deepseek | anthropic | openai-compatible.
# FALLBACKS are tried when the primary is unavailable (never while disabled).
#   openai-compatible is also how Gemini is used here — point base-url at
#   https://generativelanguage.googleapis.com/v1beta/openai with model
#   gemini-3.8-flash. Pointed instead at a model on this VPS (Ollama on
#   http://localhost:11434/v1) no transcript leaves the machine at all.
VOICE_NLU_PROVIDER=disabled
VOICE_NLU_FALLBACKS=gemini,deepseek
VOICE_NLU_GEMINI_MODEL=gemini-3.5-flash
VOICE_NLU_MODEL=claude-opus-5
VOICE_NLU_API_KEY=
VOICE_NLU_BASE_URL=

# ── Voice: end-of-consultation summary (optional, off by default) ──────────
# The narrative the dentist reads at review, generated from the session's own
# audit trail. Nothing it produces reaches a clinical record without the
# dentist editing and saving it, so a bad sentence is a nuisance rather than a
# falsified record. A large model is the right default: this runs once per
# consultation, so latency is irrelevant, and smaller models' French degrades
# noticeably on medical vocabulary.
#
# Note llama-3.3-70b-versatile is gated behind Groq's enterprise tier — a
# standard key gets a 404 from it. qwen/qwen3.8-27b is the other good option
# and produced slightly better French clinical terms in testing.
#
# Every generated summary is checked against the records before it is shown —
# a tooth that was never recorded, or a recorded tooth left out, rejects it and
# the next route tries. With generation off, or every route failing, the
# review page gets the findings as a structured report instead.
VOICE_SUMMARY_ENABLED=false
VOICE_SUMMARY_PROVIDER=groq
VOICE_SUMMARY_MODEL=openai/gpt-oss-120b
# vendor:model routes tried after the primary.
VOICE_SUMMARY_FALLBACKS=groq:qwen/qwen3.8-27b,deepseek:deepseek-flash
# Optional: the primary's key if not set as a vendor key above.
VOICE_SUMMARY_API_KEY=
VOICE_SUMMARY_BASE_URL=
# The language the summary is written in, as a name the model recognises.
VOICE_SUMMARY_LANGUAGE=French

# ── Consultation recording (optional, off by default) ──────────────────────
# The Consultation button: the doctor and patient talk, the whole conversation
# is transcribed and KEPT in the patient's file (as a note, so it can be
# reviewed later), and what matters in it — identity, allergies, history, the
# treatment plan, the next appointment — is proposed for the doctor to validate.
#
# This is a different promise from voice dictation, which discards speech that
# is not a command and keeps no transcript. Before turning it on you need: a
# DPA with every vendor named in the chain (and VOICE_<VENDOR>_DATA_PROTECTED
# set once you have read it — a free-tier key usually does not qualify), a
# lawful basis, and a CNDP notification under Law 09-08. The doctor attests at
# the start of every consultation that the patient was told.
#
# It also needs transcription (VOICE_STT_ENABLED=true) for good French; the
# browser's own recogniser is a fallback only.
CONSULTATION_ENABLED=false
# The clinic's time zone — "in 15 days" is resolved against its calendar.
CONSULTATION_TIMEZONE=Africa/Casablanca
# Keep the raw transcript in the patient's file once saved. TESTING ONLY — the
# prod profile refuses to start with it on. Off, the transcript is erased when
# the consultation is saved or discarded.
CONSULTATION_RETAIN_TRANSCRIPT=false
# An open consultation untouched this long is discarded, transcript and all.
CONSULTATION_IDLE_DISCARD_HOURS=24
# Off: nothing is sent to a model, and the side panel shows only what rules can
# read (phone, CIN, age, insurer, allergies). On: a model reads the whole
# conversation; every claim must quote the transcript or it is dropped.
CONSULTATION_EXTRACTION_ENABLED=false
CONSULTATION_EXTRACTION_PROVIDER=groq
CONSULTATION_EXTRACTION_MODEL=openai/gpt-oss-120b
CONSULTATION_EXTRACTION_FALLBACKS=groq:qwen/qwen3.8-27b,deepseek:deepseek-flash
